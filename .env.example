# ---- 渲染 ----
# Remotion 渲染时使用的 Chromium 可执行文件。留空则让 Remotion 自行下载。
# 容器/CI 环境里建议指向已有的 headless shell，避免重复下载 ~150MB。
WBS_BROWSER_EXECUTABLE=

# 渲染并发度。CPU 核少或内存紧张时设为 1。
WBS_RENDER_CONCURRENCY=1

# ---- 分镜标注（挑关键词 + 选简笔画）----
# local  分词打分 + 触发词匹配（默认，零依赖）
# glm    智谱 GLM，一次请求标注全篇；能按语义选图，不依赖触发词命中
WBS_ANNOTATOR=local
WBS_GLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
WBS_GLM_MODEL=glm-4-flash-250414
WBS_GLM_TIMEOUT=60
# 鉴权：填 key，或者留空——在 Claude Code 云环境里把 key 存成环境的
# API credential，代理会在请求离开沙箱后补上 Authorization 头，key 不进本进程
WBS_GLM_API_KEY=

# ---- 语音合成 ----
# silent          不生成音频，只按字数估算时长（默认，零依赖，开箱即用）
# indextts_http   调用 OpenAI 兼容的语音服务（社区的 IndexTTS FastAPI 封装）
# indextts_local  在本进程里直接调用 IndexTTS 的 Python API（上游官方用法）
WBS_TTS_PROVIDER=silent

# 语速倍率与单句合成超时（秒），三个 provider 通用
WBS_TTS_SPEED=1.0
WBS_TTS_TIMEOUT=180

# 合成失败时是否退回静音继续跑。默认关闭——配错了地址或音色名却悄悄出一条
# 没声音的片子，比直接失败更难排查。长任务不想被单句失败中断时才打开。
WBS_TTS_FALLBACK_SILENT=0

# --- indextts_http ---
# 服务地址（不含 /v1/audio/speech 这一段）
WBS_TTS_ENDPOINT=http://127.0.0.1:8100
# 音色名：服务端 characters/ 目录下的文件名，不带扩展名。
# 参考音频始终留在跑模型的那台机器上，不经过本进程。
WBS_TTS_VOICE=
WBS_TTS_API_KEY=
WBS_TTS_MODEL=IndexTTS

# --- indextts_local ---
# 模型目录（hf download IndexTeam/IndexTTS-2.5 --local-dir=checkpoints 的产物）
WBS_INDEXTTS_CHECKPOINTS=checkpoints
# 声音克隆的参考音频，5~10 秒的干净人声 wav。文件不出本机。
WBS_INDEXTTS_REFERENCE=
# 可选，部分版本支持：ZH / EN 等
WBS_INDEXTTS_LANG=

# ---- 工作目录 ----
WBS_WORKSPACE=.workspace
